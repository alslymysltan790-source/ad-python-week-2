import pandas as pd
import seaborn as sns
import matplotlib.pyplot as plt

a = pd.read_csv("data/day31_seaborn.csv")

plt.figure()
sns.histplot(a["Age"])
plt.show()

plt.figure()
sns.kdeplot(a["Age"])
plt.show()

plt.figure()
sns.boxplot(x=a["Age"])
plt.show()

plt.figure()
sns.countplot(x=a["Gender"])
plt.show()
