
import pandas as pd
import numpy as np
a = pd.read_csv("day21_housing.csv")
print(a.head())
a["b"] = a["sqft"].replace(0, np.nan)
a["c"] = a["price"] / a["b"]   
a["d"] = a["bedrooms"] / a["rooms"]
a["e"] = 2025 - a["year_built"]
a = a.replace([np.inf, -np.inf], np.nan)
a = a.dropna()
print(a[["price", "sqft", "bedrooms", "rooms"]].describe())
print(a[["price", "sqft", "bedrooms", "rooms", "c", "d", "e"]].describe())
